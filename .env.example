# Blog vault — cloned into the image at build time
BLOG_REPO=https://github.com/EmilioBlacksmith/blog.git

# Fine-grained PAT with read access to EmilioBlacksmith/blog (Contents: Read).
# Required unless the vault repo is publicly readable.
BLOG_REPO_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Dev.to API key — create at https://dev.to/settings (Extensions → DEV API key).
# Used by `npm run devto` to syndicate published posts.
DEVTO_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Which vault locales to syndicate (comma-separated). Default: en
# DEVTO_LOCALES=en,es

# Set to 1 to create drafts on Dev.to instead of publishing immediately.
# DEVTO_DRAFT=1

# Status sampler — records a /status history sample every 15 minutes from inside
# the web process (see instrumentation.ts + lib/status-scheduler.ts).
# Set to 0 to disable it, e.g. on extra replicas to avoid double-recording.
# STATUS_SCHEDULER=0
# Override the sampling interval in milliseconds (min 60000; default 900000).
# STATUS_INTERVAL_MS=900000

# Optional bearer token for the manual/backfill POST /api/status/record endpoint.
# STATUS_CRON_SECRET=xxxxxxxxxxxxxxxxxxxx