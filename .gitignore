# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# obsidian vault (local editor state + trash)
.obsidian/
.trash/

# blog vault content + images — lives in the separate `blog` repo,
# cloned into `blog/` and `public/blog/` at build time (see Dockerfile)
/blog/
/public/blog/

# typescript
*.tsbuildinfo
next-env.d.ts
